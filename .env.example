MYSQL_DATABASE=firefly
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_URL=jdbc:mysql://localhost:3306/firefly
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SERVER_PORT=9999
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://firefly.example/api/github/oauth/callback
GITHUB_WEBHOOK_CALLBACK_URL=https://firefly.example/api/github/webhooks
GITHUB_API_VERSION=2026-03-10
GITHUB_SCOPES=admin:repo_hook
# Base64 for exactly 32 random bytes; generate with: openssl rand -base64 32
GITHUB_ENCRYPTION_KEY=
GITHUB_ENCRYPTION_KEY_VERSION=v1
GITHUB_PROCESSING_LEASE_TIMEOUT=5m
GITHUB_PROCESSING_RETRY_DELAY=30s
GITHUB_PROCESSING_MAX_ATTEMPTS=5
GITHUB_PROCESSING_RECOVERY_INTERVAL=60s
